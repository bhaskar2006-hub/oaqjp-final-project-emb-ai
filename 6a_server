''' Executing this function initiates the application of emotion
    detection to be executed over the Flask channel and deployed on
    localhost:5000.
'''

from flask import Flask, render_template, request
from EmotionDetection.emotion_detection import emotion_detector

# Initiate the Flask app
app = Flask('Emotion Detector')


@app.route('/emotionDetector')
def sent_analyzer():
  '''Retrieves text from request arguments, passes it to emotion_detector,
  and returns the formatted output string.
  '''
  # Retrieve the text to analyze from request arguments
  text_to_analyze = request.args.get('textToAnalyze')

  # Pass the text to emotion_detector and get response
  response = emotion_detector(text_to_analyze)

  # Extract emotion scores and dominant emotion
  anger = response['anger']
  disgust = response['disgust']
  fear = response['fear']
  joy = response['joy']
  sadness = response['sadness']
  dominant_emotion = response['dominant_emotion']

  # Return formatted response string
  return (
      f"For the given statement, the system response is 'anger': {anger}, "
      f"'disgust': {disgust}, 'fear': {fear}, 'joy': {joy} and "
      f"'sadness': {sadness}. The dominant emotion is {dominant_emotion}."
  )


@app.route('/')
def render_index_page():
  '''Renders the main index page.'''
  return render_template('index.html')


if __name__ == '__main__':
  # Run the app on localhost:5000
  app.run(host='0.0.0.0', port=5000)
  